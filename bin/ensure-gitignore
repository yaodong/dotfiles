#!/usr/bin/env bash

set -e

# Ensure ~/.config/git/ignore contains all patterns from bin/gitignore.yaml.
# Merges missing patterns only; does not overwrite existing file.

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GITIGNORE_YAML="$REPO_DIR/bin/gitignore.yaml"
TARGET="$HOME/.config/git/ignore"

if [ ! -f "$GITIGNORE_YAML" ]; then
  echo "Error: $GITIGNORE_YAML not found."
  exit 1
fi

# Parse YAML patterns (requires ruby, typically on macOS/Linux)
if ! command -v ruby &>/dev/null; then
  echo "Error: ruby required to parse gitignore.yaml. Install ruby or run ensure-gitignore manually."
  exit 1
fi

patterns=()
while IFS= read -r line; do
  [ -n "$line" ] && patterns+=("$line")
done < <(ruby -ryaml -e "
  data = YAML.load_file('"$GITIGNORE_YAML"')
  (data['patterns'] || []).each { |p| puts p }
" 2>/dev/null)

if [ ${#patterns[@]} -eq 0 ]; then
  echo "No patterns found in gitignore.yaml."
  exit 0
fi

mkdir -p "$(dirname "$TARGET")"
touch "$TARGET"

# Append missing patterns (exact line match)
appended=0
for pattern in "${patterns[@]}"; do
  if ! grep -Fxq "$pattern" "$TARGET" 2>/dev/null; then
    echo "$pattern" >> "$TARGET"
    ((appended++)) || true
  fi
done

if [ "$appended" -gt 0 ]; then
  echo "Git global ignore: added $appended pattern(s) to $TARGET"
else
  echo "Git global ignore: all patterns already present."
fi
