#!/usr/bin/env bash

set -e

# Link cross-platform dotfiles on Linux.
# See bin/packages.yaml `dotfiles` section for platform tags.

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Setting up dotfiles using GNU Stow from: $REPO_DIR"

# Check if stow is installed
if ! command -v stow &>/dev/null; then
  echo "Error: GNU Stow is not installed."
  echo "Install it with: sudo apt-get install stow"
  exit 1
fi

cd "$REPO_DIR"

# Cross-platform dotfiles only (see bin/packages.yaml)
packages=(
  "cli"
  "ideavim"
  "lazygit"
  "nvim"
  "starship"
  "tmux"
  "zsh"
)

for package in "${packages[@]}"; do
  echo "Stowing $package..."
  stow --target="$HOME" --adopt --restow "$package"
done

# Ensure git global ignore has required patterns (merge, don't overwrite)
"$REPO_DIR/bin/ensure-gitignore"

echo "All cross-platform dotfiles stowed successfully!"
