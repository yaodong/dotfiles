#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "Usage: theme-sync" >&2
  exit 2
fi

appearance=$(defaults read -g AppleInterfaceStyle 2>/dev/null || echo "Light")
if [ "$appearance" = "Dark" ]; then
  target="dark"
else
  target="light"
fi

# Ghostty follows macOS automatically via `theme = light:...,dark:...`.
# Tmux uses terminal-default colors, so it tracks Ghostty with no nudge.
# Neovim picks up the same source of truth at startup; running instances get
# nudged below because they do not always receive the system notification.

nvim_tmpdir="${TMPDIR:-/tmp/}"
for sock in "${nvim_tmpdir}nvim.${USER}"/*/nvim.*.0; do
  [ -S "$sock" ] && nvim --server "$sock" --remote-expr "execute('set background=$target')" 2>/dev/null || true
done
