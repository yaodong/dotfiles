#!/usr/bin/env bash

set -e

# Get the absolute path to the repository root directory
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Setting up dotfiles using GNU Stow from: $REPO_DIR"

# Check if stow is installed
if ! command -v stow &>/dev/null; then
  echo "Error: GNU Stow is not installed."
  echo "Install it with: brew install stow"
  exit 1
fi

# Change to repo root (stow packages are at top level)
cd "$REPO_DIR"

# Stow all packages (hardcoded list)
packages=(
  "bin"
  "claude"
  "cursor"
  "ghostty"
  "ideavim"
  "nvim"
  "starship"
  "tmux"
  "zed"
  "zsh"
)

for package in "${packages[@]}"; do
  echo "Stowing $package..."
  stow --target="$HOME" --adopt --restow "$package"
done

# Ensure git global ignore has required patterns (merge, don't overwrite)
"$REPO_DIR/bin/ensure-gitignore"

# Wire up Claude Code hooks (idempotent)
"$REPO_DIR/bin/ensure-claude-hooks"

# Install overcommit git hooks (idempotent; skips if gem not installed)
if command -v overcommit &>/dev/null; then
  (cd "$REPO_DIR" && overcommit --install >/dev/null && overcommit --sign >/dev/null)
  echo "Overcommit: hooks installed and signed."
else
  echo "Overcommit: skipping (not on PATH; gem install overcommit)."
fi

echo "All dotfiles stowed successfully!"
