#!/usr/bin/env bash

set -e

# Get the absolute path to the repository root directory
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Setting up dotfiles using GNU Stow from: $REPO_DIR"

# Check if stow is installed
if ! command -v stow &>/dev/null; then
  echo "Error: GNU Stow is not installed."
  echo "Install it with: brew install stow"
  exit 1
fi

# Change to repo root (stow packages are at top level)
cd "$REPO_DIR"

# Stow all packages (hardcoded list)
packages=(
  "cursor"
  "ghostty"
  "ideavim"
  "lazygit"
  "nvim"
  "starship"
  "tmux"
  "zed"
  "zsh"
)

for package in "${packages[@]}"; do
  echo "Stowing $package..."
  stow --target="$HOME" --restow "$package"
done

# Symlink theme-toggle script
mkdir -p "$HOME/.local/bin"
ln -sf "$REPO_DIR/utils/theme-toggle" "$HOME/.local/bin/theme-toggle"

# Ensure git global ignore has required patterns (merge, don't overwrite)
"$REPO_DIR/utils/ensure-gitignore"

echo "All dotfiles stowed successfully!"
