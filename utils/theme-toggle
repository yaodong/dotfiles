#!/usr/bin/env bash

set -e

STATE_DIR="$HOME/.config/theme"
STATE_FILE="$STATE_DIR/current"

# Ensure state directory exists
mkdir -p "$STATE_DIR"

# Read current theme from state file (default to light)
current="light"
if [ -f "$STATE_FILE" ]; then
  current=$(cat "$STATE_FILE")
fi

# Determine target theme
if [ -n "$1" ]; then
  target="$1"
else
  if [ "$current" = "dark" ]; then
    target="light"
  else
    target="dark"
  fi
fi

# Map theme to app-specific values
if [ "$target" = "light" ]; then
  zed_mode="light"
else
  zed_mode="dark"
fi

# 1. Save state
echo "$target" > "$STATE_FILE"

# 2. Update Zed theme mode
zed_config="$HOME/.config/zed/settings.json"
if [ -f "$zed_config" ]; then
  tmp=$(mktemp)
  sed "s/\"mode\": \"[^\"]*\"/\"mode\": \"$zed_mode\"/" "$zed_config" > "$tmp"
  cat "$tmp" > "$zed_config"
  rm "$tmp"
fi

echo "Switched to $target mode"
